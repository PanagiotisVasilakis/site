# Copy to .env.local for development. Never commit real credentials.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://site_user:change-me@localhost:5433/site_dev
TEST_DATABASE_URL=postgresql://site_user:change-me@localhost:5433/site_test

# Authentication and encryption
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_DASH_SECRET=replace-with-at-least-20-random-characters
GUEST_JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
SECURITY_PEPPER=replace-with-a-random-secret
SECURITY_ENC_KEY_HEX=replace-with-exactly-64-hex-characters
GUEST_WIFI_NETWORK=replace-with-guest-network-name
GUEST_WIFI_PASSWORD=replace-with-guest-network-password

# Controlled onsite confirmation (disabled unless explicitly configured)
ONSITE_CONFIRM_ENABLED=0
ONSITE_CONFIRM_JWT_SECRET=replace-with-at-least-32-random-characters

# Public application origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Optional shared services
VALID_API_KEYS=
INTERNAL_API_KEYS=
METRICS_WRITE_API_KEYS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
CHECKIN_REQUEST_WEBHOOK_URL=
CHECKIN_REQUEST_WEBHOOK_TOKEN=
BOOKING_REQUEST_WEBHOOK_URL=
BOOKING_REQUEST_WEBHOOK_TOKEN=
CRON_SECRET=replace-with-at-least-32-random-characters

# Optional runtime behavior
RATE_LIMIT_BACKEND=
TRUST_PROXY_HOPS=0
# Set only behind a proxy that overwrites this header: cf-connecting-ip or x-real-ip
CLIENT_IP_HEADER=
DEV_SESSION_MINT_ENABLED=0
DEV_SESSION_MINT_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_PERSIST=0
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_STORAGE=file
ANALYTICS_HASH_PATHS=0
NEXT_PUBLIC_ENABLE_PERF_TELEMETRY=false
