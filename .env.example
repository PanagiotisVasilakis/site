# Reference only: `npm run ensure-pepper` creates .env.local. Never commit real credentials.
NODE_ENV=development

# Database
DATABASE_URL=postgresql://devuser:devpass@localhost:5433/site_dev
# Matches the disposable dev database in docker-compose.yml (POSTGRES_* defaults); `npm run ensure-pepper` writes the same value.
# Optional: DIRECT_URL overrides DATABASE_URL for Prisma CLI commands (e.g. a non-pooled connection).

# Authentication. Production requires three independently generated,
# high-entropy values; never reuse a value between these names.
# Development may leave the JWT values empty and use process-local signers.
# An empty dashboard value disables the development admin login endpoint.
ADMIN_JWT_SECRET=
ADMIN_DASH_SECRET=
GUEST_JWT_SECRET=
SECURITY_PEPPER=replace-with-a-random-secret
CLAIM_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# The Wi-Fi values are shown to guests as they are. Production rejects the placeholders below
# (a value that contains replace, changeme, placeholder or example, in any case), like the peppers above.
GUEST_WIFI_NETWORK=replace-with-guest-network-name
GUEST_WIFI_PASSWORD=replace-with-guest-network-password
# Not read: the app uses the PROPERTY_TIME_ZONE constant in src/data/stayPolicy.ts; startup only validates this value.
PROPERTY_TIME_ZONE=Europe/Athens

# Public application origin
# Production requires a bare https origin: https://host[:port], at most one trailing slash, no path,
# query, fragment, credentials or spaces. Write the host in lowercase, as punycode (xn--) when it has
# non-ASCII letters, and without :443. Every canonical, hreflang, OG, sitemap and JSON-LD URL starts with it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set by the production image (docker/Dockerfile.security) to the URL compiled into it; startup
# rejects a different NEXT_PUBLIC_SITE_URL and applies the same bare-origin rule. Leave empty outside the image.
BUILD_SITE_URL=
ALLOWED_ORIGINS=http://localhost:3000

# Optional shared services. When the check-in URL is set, its token is required.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_REQUIRED=0
CHECKIN_REQUEST_WEBHOOK_URL=
CHECKIN_REQUEST_WEBHOOK_TOKEN=
# Booking.com calendar export URL (iCal): the only source of the availability calendar. The owner creates it
# in the Booking.com extranet with booked and closed dates; public guides show the shape
# https://ical.booking.com/v1/export?t=<token> (older: https://admin.booking.com/hotel/hoteladmin/ical.html?t=<token>).
# A value of another shape (other host or path, http, a non-default port, userinfo, no query)
# stops the web container at start-up.
# secret: contains a token; production only; never commit a real value
BOOKING_ICAL_URL=
# Public CARTO basemaps key, optional; without it the map uses OpenStreetMap tiles.
CARTO_BASEMAPS_KEY=

# Optional runtime behavior.
# Production ingress secret. Generate with: openssl rand -hex 32
# Inject the same root-owned value into Nginx and the application; never commit it.
# Development: `npm run ensure-pepper` writes a local value and `npm run dev:proxy` sends it.
ORIGIN_PROXY_SHARED_SECRET=
PRISMA_LOG_LIFECYCLE=0
LOG_LEVEL=debug
LOG_CONSOLE=true
LOG_STRUCTURED=false
LOG_MAX_METADATA_SIZE=1000
