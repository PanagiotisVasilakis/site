# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# bundled workers for the production image (scripts/build-workers.mjs)
/dist/

# local test output
/coverage/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel
/src/generated/prisma/
# worker bundle output of tests/unit/build-workers.test.ts (left behind only by an aborted run)
/tmp-build-workers-*/

# typescript
*.tsbuildinfo
next-env.d.ts
.vscode/settings.json
public/version.json
*CLAUDE*.md
*AGENTS*.md
*GEMINI*.md
*QWEN*.md

.venv

# agent knowledge
/agent-knowledge/
/.codex/
/graphify-out/
/.claude/
jpegmini_*/
