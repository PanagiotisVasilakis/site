# Runtime configuration of the web, outbox and operations services of
# docker/docker-compose.prod.yml (APP_ENV_FILE in docker/.env).
#
# Install as root, then edit:
#   install -m 0600 -o root -g root deploy/host/app.env.example /opt/qr-city-guide/app.env
# Start-up validates this file (src/lib/runtime-env-schema.js) and exits with status 78 when a
# value is missing or weak. The message names the variable, never the value.
#
# Syntax (Docker Compose env_file): KEY=value, one per line, no spaces around "=", no "export".
# Put a value in SINGLE quotes when it contains $, #, a space or a backslash, for example
# 'my#pass word'. Unquoted and double-quoted values expand $name, and an unquoted " #" starts a
# comment. A single quote cannot be part of a single-quoted value, so choose values without one.
#
# Every <...> below is a placeholder: replace it, brackets included. Before the first start,
#   grep -n '^[^#]*<' /opt/qr-city-guide/app.env
# must print nothing. Never commit this file and never paste it into a chat or a ticket.

# The compose file pins this for web, outbox and operations; it is listed for completeness.
NODE_ENV=production

# Database, application role. "db" is the compose service. The role and its password are created
# once, as described in scripts/README.md ("Host layout"); use hex only (openssl rand -hex 32), so
# that nothing needs URL escaping. The database name is POSTGRES_DB of docker/.env. The URL must
# not carry an "options" parameter: the application pins every session to TimeZone=UTC through it,
# and a value in the URL would replace that pin. The migration role (qr_migrator) belongs in
# migrate.env, not here.
DATABASE_URL=postgresql://qr_app:<DB_PW>@db:5432/qr_city_guide

# Three independent secrets for the admin session, the guest session and the admin login. Generate
# each one separately with: openssl rand -hex 32
# Production start-up rejects equal values, placeholder words, repeated patterns and weak values.
# What a rotation does: docs/security/runtime-credential-contract.md
ADMIN_JWT_SECRET=<GENERATE: openssl rand -hex 32>
GUEST_JWT_SECRET=<GENERATE: openssl rand -hex 32>
ADMIN_DASH_SECRET=<GENERATE: openssl rand -hex 32>

# Two peppers, again separate values from openssl rand -hex 32 (at least 16 and 32 characters),
# different from the three secrets above.
SECURITY_PEPPER=<GENERATE: openssl rand -hex 32>
CLAIM_TOKEN_PEPPER=<GENERATE: openssl rand -hex 32>

# The real Wi-Fi of the apartment, shown to guests after sign-in (password: at least 8 characters).
GUEST_WIFI_NETWORK='<real Wi-Fi network name>'
GUEST_WIFI_PASSWORD='<real Wi-Fi password>'

# Validated at start-up but not read: the property time zone is a constant in the code.
PROPERTY_TIME_ZONE=Europe/Athens

# Leave blank. Requests from the site's own origin are always allowed. Do not list a www alias
# here: redirect it to the canonical host at Cloudflare (docs/deployment/cloudflare-checklist.md).
ALLOWED_ORIGINS=

# The public origin: https, the canonical host name in lowercase, no path. It must be exactly the
# value of NEXT_PUBLIC_SITE_URL at the image build (npm run docker:build): it is compiled into the
# image, and the web container refuses to start when this line differs. deploy/host/render-nginx.sh
# takes the Nginx server_name from this line.
NEXT_PUBLIC_SITE_URL=https://<your-host.example>

# BUILD_SITE_URL is set by the image to the URL it was built for. Do not set it here.

# Secret shared with Nginx (the same 64 hex characters). deploy/host/render-nginx.sh reads it from
# this line and renders it into the Nginx configuration; never type it into the Nginx file by hand.
# Generate with: openssl rand -hex 32
ORIGIN_PROXY_SHARED_SECRET=<GENERATE: openssl rand -hex 32>

# Check-in request notifications (optional). Leave both empty to send none. With a URL the token
# is mandatory (at least 20 characters), and the URL must be https. The exact request that is sent
# is in docs/deployment/monitoring-and-alerting.md.
CHECKIN_REQUEST_WEBHOOK_URL=
CHECKIN_REQUEST_WEBHOOK_TOKEN=

# Operational alerts (optional but recommended). Without a URL the alerts stay as rows in the
# database and nothing tells you. The token is optional (at least 20 characters when set).
# ALERT_WEBHOOK_REQUIRED=1 makes web refuse to start while the URL is missing, and makes an
# operations run fail while an alert is open that could not be announced; keep 0 until the
# receiver exists. Do not leave it empty: only 0 or 1 is valid.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
# 0 or 1:
ALERT_WEBHOOK_REQUIRED=0

# Booking.com calendar export (secret, optional; the availability page shows no calendar without
# it). Read scripts/README.md ("Required runtime configuration") before you set it: the link has a
# fixed shape and a rejected value stops the web container at start-up.
BOOKING_ICAL_URL=

# Public CARTO basemaps key (optional; without it the map uses OpenStreetMap tiles).
CARTO_BASEMAPS_KEY=

# Logging. Structured output is one JSON object per line, which is what journald and a log
# reader expect. LOG_LEVEL is one of trace, debug, info, warn, error.
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_STRUCTURED=true
# Optional: LOG_MAX_METADATA_SIZE=1000 (a whole number) and PRISMA_LOG_LIFECYCLE=1 (database
# connection lifecycle logging, for a diagnosis only).
