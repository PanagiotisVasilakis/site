# Host settings: the ".env" next to the compose file, /opt/qr-city-guide/docker/.env.
# Docker Compose reads it from the directory of docker/docker-compose.prod.yml, not from the
# directory you run the command in, and the cron jobs and deploy/host/*.sh scripts read it too.
#
# Install as root, then edit:
#   install -m 0600 -o root -g root deploy/host/compose.env.example /opt/qr-city-guide/docker/.env
#
# Syntax: KEY=value, one per line, no spaces around "=", no "export". Put a value in single quotes
# if it contains $, #, a space or a backslash (see app.env.example). Replace every <...>
# (brackets included); grep -n '^[^#]*<' /opt/qr-city-guide/docker/.env must print nothing.
# A variable that the shell exports overrides the same name in this file.

# ---------------------------------------------------------------------------------------------
# Docker Compose (docker/docker-compose.prod.yml)
# ---------------------------------------------------------------------------------------------

# The web image of the release that runs, as printed by npm run docker:build, for example
# villa-app:0123456789ab. The -workers and -migrate images are derived from it. Change this line
# after "migrate" of a release has succeeded: the cron jobs read it and start that release's workers.
APP_IMAGE=villa-app:<12 hex characters of the release commit>

# The two root-owned env files (app.env.example, migrate.env.example).
APP_ENV_FILE=/opt/qr-city-guide/app.env
MIGRATE_ENV_FILE=/opt/qr-city-guide/migrate.env

# The bundled PostgreSQL creates only this superuser, and only the first time it starts on an empty
# volume; changing these three lines later does not change the existing database. The application
# never connects as this user (it uses qr_app and qr_migrator), and no published port is needed:
# the backup and the maintenance commands reach the database through the db container.
# The password: openssl rand -hex 32
POSTGRES_USER=qr_postgres
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 32>
POSTGRES_DB=qr_city_guide

# Optional ports, published on 127.0.0.1 only. Keep WEB_PORT at 3000: the Nginx template proxies
# to 127.0.0.1:3000. Change POSTGRES_PORT only if another service already uses 5432.
# POSTGRES_PORT=5432
# WEB_PORT=3000

# ---------------------------------------------------------------------------------------------
# Host scripts (deploy/host): Docker Compose ignores everything below.
# ---------------------------------------------------------------------------------------------

# Heartbeat (dead-man's switch) URLs, one per job, from an external monitor
# (docs/deployment/monitoring-and-alerting.md). A job pings the URL after a successful run and
# <URL>/fail after a failed one. https only; the URL is a secret, so it lives in this file and
# nowhere else. Leave empty for no ping.
HEALTHCHECK_URL_OUTBOX=
HEALTHCHECK_URL_OPERATIONS=
HEALTHCHECK_URL_HOSTCHECK=
HEALTHCHECK_URL=
# The limits of check-host.sh (defaults: 85 percent disk, 200 MB memory, 60 days of certificate):
# CHECK_DISK_MAX_PERCENT=85, CHECK_MEM_MIN_MB=200, CHECK_CERT_MIN_DAYS=60

# Backup (deploy/host/backup.sh, docs/deployment/backup-and-restore.md). Backups are always
# encrypted: age (default) or gpg. The private key never belongs on this server.
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENTS_FILE=/opt/qr-city-guide/backup-recipients.txt
# For gpg instead: BACKUP_ENCRYPTION=gpg and the key id or fingerprint of the public key.
# BACKUP_GPG_RECIPIENT=
# A directory of its own: if it exists it must belong to the user who runs the backup and have mode
# 0700 (the script never changes the mode of a directory it did not create); /tmp, /var and the
# like are refused. The day-0 runbook creates it with install -d -m 0700.
BACKUP_DIR=/opt/qr-city-guide/backups
BACKUP_RETENTION_DAYS=14
# Optional off-site copy through rclone (name:path of a remote from the rclone configuration; the
# credentials stay in the rclone configuration file, never here). Empty = no off-site copy.
RCLONE_REMOTE=
# Optional: delete off-site copies older than this many days. Needs a credential that may delete;
# without it, let the storage provider expire old copies. The copies hold personal data, so one of
# the two is required: backup.sh warns on every run while a remote is set and this is empty.
# RCLONE_RETENTION_DAYS=14
# Less common: BACKUP_KEEP_MIN (3), BACKUP_MIN_FREE_MB (1024), BACKUP_TIMEOUT_SECONDS (1800),
# RCLONE_CONFIG (path of the rclone configuration file) and GNUPGHOME (gpg keyring).
