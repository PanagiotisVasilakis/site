# Configuration of the migration run (MIGRATE_ENV_FILE in docker/.env):
#   docker compose -f docker/docker-compose.prod.yml --profile ops run --rm migrate
#
# Install as root, then edit:
#   install -m 0600 -o root -g root deploy/host/migrate.env.example /opt/qr-city-guide/migrate.env
#
# The migration role owns every table; the application role (app.env) can only read and write
# rows. Create both roles once, before the first migration, as described in scripts/README.md
# ("Host layout"). The syntax rules are those of app.env.example. Replace every <...> (brackets
# included); grep -n '^[^#]*<' /opt/qr-city-guide/migrate.env must print nothing before the first run.
#
# Only DATABASE_URL is needed. Do not set DIRECT_URL: when it is set, it replaces DATABASE_URL for
# the migration command (prisma.config.ts).

# Host "db" is the compose service, and the database name is POSTGRES_DB of docker/.env. <DB_PW> is
# the password of the qr_migrator role, hex only (openssl rand -hex 32), different from the qr_app
# password in app.env. The URL must not carry an "options" parameter.
DATABASE_URL=postgresql://qr_migrator:<DB_PW>@db:5432/qr_city_guide
