{
  "name": "qr-city-guide",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.18.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "dev": "next dev -H 0.0.0.0",
    "dev:proxy": "node scripts/dev-proxy.mjs",
    "predev": "node scripts/check-pepper.js",
    "build": "tsx scripts/validate-content.ts && tsx scripts/generate-version.ts && next build",
    "build:workers": "node scripts/build-workers.mjs",
    "typecheck": "tsc --noEmit",
    "prestart": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts --reporter=default",
    "test:integration": "tsx tests/integration/run.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/unit --reporter=default",
    "test:components": "vitest run --config vitest.config.ts tests/components --reporter=default",
    "test:routes": "vitest run --config vitest.config.ts tests/routes --reporter=default",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --reporter=default",
    "test:security": "vitest run --config vitest.config.ts tests/security --reporter=default",
    "test:postgres-image-policy": "vitest run --config vitest.config.ts tests/unit/postgres-image-policy.test.ts --reporter=default",
    "test:runtime-credentials": "node scripts/test-runtime-credential-contract.mjs",
    "check:dead-code": "knip --include files,dependencies,unlisted,binaries",
    "check:image-assets": "tsx scripts/check-image-assets.ts",
    "design:icons": "tsx scripts/design/gen-app-icons.ts",
    "design:hero": "tsx scripts/design/gen-hero-assets.ts",
    "design:og": "tsx scripts/design/gen-og-images.ts",
    "lint:security": "eslint --config eslint.config.security.mjs . --max-warnings=0",
    "outbox:drain": "tsx scripts/drain-outbox.ts",
    "operations:check": "tsx scripts/run-operational-maintenance.ts",
    "security:license-check": "tsx scripts/check-licenses.ts",
    "docker:build": "bash ./scripts/docker-build.sh",
    "docker:scan": "bash ./scripts/docker-scan.sh \"$(bash ./scripts/image-tag.sh)\"",
    "validate:security": "tsx scripts/validate-security.ts",
    "validate:local": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run test:coverage && npm run validate:security",
    "db:start": "docker compose up -d --wait db",
    "db:migrate": "prisma migrate deploy",
    "ensure-pepper": "node scripts/ensure-pepper.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "jsonwebtoken": "9.0.3",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/spdx-expression-parse": "^3.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^17.0.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-security": "^3.0.1",
    "jsdom": "29.1.1",
    "knip": "6.26.0",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "puppeteer": "25.12.0",
    "spdx-expression-parse": "^4.0.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.25",
    "deepmerge-ts": "^8.0.2",
    "fast-uri": "^3.1.8",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true,
    "puppeteer@25.12.0": true,
    "unrs-resolver@1.11.1": true
  }
}
