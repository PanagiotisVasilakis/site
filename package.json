    "qr": "tsx scripts/generate-qr.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "next": "15.5.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
  "jsonwebtoken": "^9.0.2",
  "web-vitals": "^4.2.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
  "typescript": "^5",
  "vitest": "^2.1.9",
  "vite-tsconfig-paths": "^5.1.3"
  ,"@types/jsonwebtoken": "^9.0.6"
  }
