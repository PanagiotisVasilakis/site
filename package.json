{
  "name": "qr-city-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-precache.ts && tsx scripts/validate-content.ts && tsx scripts/generate-version.ts && next build --turbopack",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "qr": "tsx scripts/generate-qr.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "contrast": "node scripts/contrast-scan.ts",
    "audit:contrast": "node scripts/axe-contrast.ts",
    "audit:a11y": "node scripts/axe-a11y.ts"
  },
  "dependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "puppeteer": "^23.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^3.2.4"
  }
}
