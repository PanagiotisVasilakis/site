{
  "name": "qr-city-guide",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.18.0"
  },
  "scripts": {
    "migrate": "bash ./scripts/system-orchestrator.sh migrate --profile production",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:all": "tsx scripts/run-prisma-migrations.ts",
    "prisma:format": "prisma format",
    "prisma:smoketest": "tsx scripts/prisma-smoketest.ts",
    "dev": "next dev -H 0.0.0.0",
    "predev": "node scripts/check-pepper.js",
    "dev:clean": "rm -rf .next/cache && next dev -H 0.0.0.0",
    "build": "tsx scripts/generate-precache.ts && tsx scripts/validate-content.ts && tsx scripts/generate-version.ts && next build",
    "build:turbopack": "tsx scripts/generate-precache.ts && tsx scripts/validate-content.ts && tsx scripts/generate-version.ts && next build --turbopack",
    "build:secure": "npm run security:audit && npm run build",
    "typecheck": "tsc --noEmit",
    "prestart": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs .next/standalone/server.js",
    "lint": "eslint",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "check:dead-code": "knip --include files,dependencies,unlisted,binaries",
    "lint:security": "eslint --config eslint.config.security.mjs . --max-warnings=0",
    "qr": "tsx scripts/generate-qr.ts",
    "check:offline-assets": "tsx scripts/check-offline-assets.ts",
    "test:analytics": "tsx scripts/test-analytics.ts",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts --reporter=default",
    "test:db": "vitest run --config vitest.db.config.ts --reporter=default",
    "test:all": "npm run test:unit && npm run test:db",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:security": "vitest run src/__tests__/security.test.ts src/__tests__/security-hardening.test.ts src/lib/__tests__/security-middleware.test.ts",
    "test:api": "vitest run src/__tests__/api.endpoints.test.ts",
    "test:api:load": "tsx src/__tests__/api-load-test.ts",
    "test:api:load:normal": "tsx src/__tests__/api-load-test.ts normal",
    "test:api:load:stress": "tsx src/__tests__/api-load-test.ts stress",
    "test:api:live-load": "tsx src/__tests__/api-load-test.ts normal",
    "contrast": "tsx scripts/axe-contrast.ts",
    "audit:contrast": "tsx scripts/axe-contrast.ts",
    "audit:a11y": "tsx scripts/axe-a11y.ts",
    "ci:a11y": "AXE_JSON=timestamp tsx scripts/axe-a11y.ts",
    "ci:contrast": "AXE_JSON=timestamp tsx scripts/axe-contrast.ts",
    "ci:accessibility": "npm run ci:contrast && npm run ci:a11y && npm run reports:prune",
    "ci:test:db": "NODE_ENV=test npm run test:db",
    "wait:http": "tsx scripts/wait-for-http.ts",
    "outbox:drain": "tsx scripts/drain-outbox.ts",
    "operations:check": "tsx scripts/run-operational-maintenance.ts",
    "reports:prune": "tsx scripts/prune-reports.ts",
    "check:browser-runtime": "tsx scripts/check-browser-runtime.ts",
    "fonts:download": "tsx scripts/download-fonts.ts",
    "lighthouse:mobile": "tsx scripts/run-lighthouse.ts",
    "lighthouse:desktop": "tsx scripts/run-lighthouse-desktop.ts",
    "audit:lighthouse:matrix": "tsx scripts/lighthouse-matrix.ts",
    "ci:lighthouse:matrix": "LH_MATRIX_FAIL_ON_ISSUES=1 LH_MATRIX_MIN_SCORE=70 tsx scripts/lighthouse-matrix.ts",
    "audit:responsive:ux": "tsx scripts/responsive-ux-audit.ts",
    "ci:responsive:ux": "RESPONSIVE_UX_FAIL_ON_ISSUES=1 tsx scripts/responsive-ux-audit.ts",
    "security:audit": "npm audit --audit-level=high",
    "security:audit-fix": "npm audit fix",
    "security:license-check": "tsx scripts/check-licenses.ts",
    "security:outdated": "npm outdated",
    "security:scan": "npm run security:audit && npm run security:license-check && npm run lint:security",
    "docker:build": "docker build --build-arg NEXT_PUBLIC_SITE_URL=\"${NEXT_PUBLIC_SITE_URL:?NEXT_PUBLIC_SITE_URL is required}\" -f docker/Dockerfile.security -t villa-app:latest .",
    "docker:scan": "docker scout cves villa-app:latest || trivy image villa-app:latest",
    "docker:security-test": "docker run --rm -v \"$PWD\":/app -w /app aquasec/trivy fs .",
    "validate:security": "tsx scripts/validate-security.ts",
    "query-guests": "tsx scripts/query-guests.ts",
    "db:start": "bash ./scripts/system-orchestrator.sh bootstrap --profile development --db-only --skip-build --skip-migrate",
    "db:check": "bash ./scripts/system-orchestrator.sh bootstrap --profile development --db-only --skip-build --skip-migrate",
    "db:logs": "docker logs --follow site-dev-db",
    "db:studio": "bash ./scripts/system-orchestrator.sh bootstrap --profile development --db-only --skip-build --skip-migrate && npx prisma studio --port 5555",
    "db:migrate": "bash ./scripts/system-orchestrator.sh migrate --profile development --db-only",
    "db:generate": "bash ./scripts/system-orchestrator.sh bootstrap --profile development --db-only --skip-build --skip-migrate && npm run prisma:generate",
    "ensure-pepper": "node scripts/ensure-pepper.js",
    "system:bootstrap": "bash ./scripts/system-orchestrator.sh bootstrap",
    "system:up": "bash ./scripts/system-orchestrator.sh up",
    "system:down": "bash ./scripts/system-orchestrator.sh down",
    "system:restart": "bash ./scripts/system-orchestrator.sh restart",
    "system:status": "bash ./scripts/system-orchestrator.sh status",
    "system:logs": "bash ./scripts/system-orchestrator.sh logs",
    "system:verify": "bash ./scripts/system-orchestrator.sh verify",
    "system:build": "bash ./scripts/system-orchestrator.sh build",
    "system:migrate": "bash ./scripts/system-orchestrator.sh migrate",
    "system:check": "bash ./scripts/system-orchestrator.sh check",
    "systemd:install": "sudo bash ./scripts/install-systemd-services.sh",
    "ci:orchestrator-check": "bash ./scripts/ci-orchestrator-check.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "^17.0.0",
    "framer-motion": "^12.42.2",
    "jsonwebtoken": "9.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.2.4",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "web-vitals": "^4.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "1.9.21",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/spdx-expression-parse": "^3.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-security": "^3.0.1",
    "jsdom": "^26.1.0",
    "knip": "6.26.0",
    "lighthouse": "^13.4.0",
    "postcss": "8.5.19",
    "prisma": "^7.0.0",
    "puppeteer": "24.43.1",
    "spdx-expression-parse": "^4.0.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "overrides": {
    "@prisma/dev": "0.24.14",
    "@sentry/node": "^10.64.0",
    "postcss": "$postcss"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "@tailwindcss/oxide@4.3.2": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.25.9": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "prisma@7.8.0": true,
    "puppeteer@24.43.1": true,
    "unrs-resolver@1.11.1": true
  }
}
