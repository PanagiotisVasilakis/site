{
  "name": "qr-city-guide",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:all": "tsx scripts/run-prisma-migrations.ts",
    "prisma:format": "prisma format",
    "prisma:smoketest": "tsx scripts/prisma-smoketest.ts",
    "dev": "next dev -H 0.0.0.0",
    "predev": "node scripts/check-pepper.js",
    "dev:clean": "rm -rf .next/cache && next dev -H 0.0.0.0",
    "build": "tsx scripts/generate-precache.ts && tsx scripts/validate-content.ts && tsx scripts/generate-version.ts && next build",
    "build:turbopack": "tsx scripts/generate-precache.ts && tsx scripts/validate-content.ts && tsx scripts/generate-version.ts && next build --turbopack",
    "build:secure": "npm run security:audit && npm run build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "lint:security": "eslint --ext .js,.jsx,.ts,.tsx --config eslint.config.security.mjs .",
    "qr": "tsx scripts/generate-qr.ts",
    "check:offline-assets": "tsx scripts/check-offline-assets.ts",
    "test:analytics": "tsx scripts/test-analytics.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:db:lookup": "vitest run src/__tests__/bookingLookup.test.ts # requires TEST_DATABASE_URL",
    "test:api": "tsx src/__tests__/api-test-runner.ts",
    "test:api:load": "tsx src/__tests__/api-load-test.ts",
    "test:api:load:normal": "tsx src/__tests__/api-load-test.ts normal",
    "test:api:load:stress": "tsx src/__tests__/api-load-test.ts stress",
    "test:api:comprehensive": "npm run test:api && npm run test:api:load:normal",
    "contrast": "tsx scripts/contrast-scan.ts",
    "audit:contrast": "tsx scripts/axe-contrast.ts",
    "audit:a11y": "tsx scripts/axe-a11y.ts",
    "ci:a11y": "AXE_JSON=timestamp tsx scripts/axe-a11y.ts",
    "ci:contrast": "AXE_JSON=timestamp tsx scripts/axe-contrast.ts",
    "ci:accessibility": "npm run ci:contrast && npm run ci:a11y && npm run reports:prune",
    "ci:test:db": "NODE_ENV=test vitest run --reporter=default",
    "reports:prune": "tsx scripts/prune-reports.ts",
    "fonts:download": "tsx scripts/download-fonts.ts",
    "lighthouse:mobile": "tsx scripts/run-lighthouse.ts",
    "security:audit": "npm audit --audit-level=high",
    "security:audit-fix": "npm audit fix",
    "security:license-check": "tsx scripts/check-licenses.ts",
    "security:outdated": "npm outdated",
    "security:scan": "npm run security:audit && npm run security:license-check && npm run lint:security",
    "docker:build": "docker build -f docker/Dockerfile.security -t villa-app:latest .",
    "docker:scan": "docker scout cves villa-app:latest || trivy image villa-app:latest",
    "docker:security-test": "docker run --rm -v \"$PWD\":/app -w /app aquasec/trivy fs .",
    "validate:security": "tsx scripts/validate-security.ts",
    "query-guests": "tsx scripts/query-guests.ts",
    "db:start": "bash ./scripts/db-check.sh",
    "db:check": "bash ./scripts/db-check.sh",
    "db:logs": "docker logs --follow site-dev-db",
    "db:studio": "bash ./scripts/db-check.sh studio",
    "db:migrate": "bash ./scripts/db-check.sh migrate",
    "db:generate": "bash ./scripts/db-check.sh generate",
    "ensure-pepper": "node scripts/ensure-pepper.js",
    "system:bootstrap": "bash ./scripts/system-orchestrator.sh bootstrap",
    "system:up": "bash ./scripts/system-orchestrator.sh up",
    "system:down": "bash ./scripts/system-orchestrator.sh down",
    "system:restart": "bash ./scripts/system-orchestrator.sh restart",
    "system:status": "bash ./scripts/system-orchestrator.sh status",
    "system:logs": "bash ./scripts/system-orchestrator.sh logs",
    "system:verify": "bash ./scripts/system-orchestrator.sh verify",
    "system:build": "bash ./scripts/system-orchestrator.sh build",
    "system:migrate": "bash ./scripts/system-orchestrator.sh migrate",
    "system:check": "bash ./scripts/system-orchestrator.sh check",
    "systemd:install": "sudo bash ./scripts/install-systemd-services.sh",
    "ci:orchestrator-check": "bash ./scripts/ci-orchestrator-check.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.17.1",
    "@types/jsdom": "^21.1.7",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "jose": "^6.1.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^15.5.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-day-picker": "^9.10.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.70.0",
    "uuid": "^13.0.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.36.0",
    "@npmcli/arborist": "^7.5.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^20.19.17",
    "@types/npmcli__arborist": "^6.3.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/spdx-expression-parse": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.0",
    "eslint-plugin-security": "^3.0.1",
    "lighthouse": "^12.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.17.1",
    "puppeteer": "^24.9.0",
    "spdx-expression-parse": "^4.0.0",
    "spdx-satisfies": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
}
