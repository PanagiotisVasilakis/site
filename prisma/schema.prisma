generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String               @id @db.Uuid
  email            String?              @unique
  phoneE164        String               @unique(map: "users_phone_e164_key") @map("phone_e164") @db.VarChar(32)
  passwordHash     String?              @map("password_hash")
  countryOrigin    CountryOrigin        @map("country_origin")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings         Booking[]
  mfaChallenges    MfaChallenge[]
  mfaFactors       MfaFactor[]
  refreshFamilies  RefreshTokenFamily[]
  refreshTokens    RefreshToken[]
  sessions         Session[]
  checkInRequests  CheckInRequest[]
  termsAcceptances TermsAcceptance[]
  privacyRequests  PrivacyRequest[]
  privacyHolds     PrivacyHold[]

  @@index([countryOrigin], map: "idx_users_country_origin")
  @@index([createdAt], map: "idx_users_created_at")
  @@index([updatedAt], map: "idx_users_updated_at")
  @@index([phoneE164, countryOrigin], map: "idx_users_phone_country")
  @@index([email, passwordHash], map: "idx_users_email_password")
  @@map("users")
}

model Booking {
  id                String              @id @db.Uuid
  source            BookingSource
  reference         String?
  startDate         DateTime            @map("start_date") @db.Date
  endDate           DateTime            @map("end_date") @db.Date
  userId            String?             @map("user_id") @db.Uuid
  provider          String              @default("legacy") @db.VarChar(32)
  externalReference String?             @map("external_reference") @db.VarChar(128)
  accessStatus      AccessStatus        @default(PENDING) @map("access_status")
  claimedAt         DateTime?           @map("claimed_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkin           Checkin?
  sessions          Session[]
  checkInRequests   CheckInRequest[]
  claimGrants       BookingClaimGrant[]
  termsAcceptances  TermsAcceptance[]
  privacyRequests   PrivacyRequest[]
  privacyHolds      PrivacyHold[]

  @@unique([provider, externalReference], map: "bookings_provider_external_reference_key")
  @@index([reference], map: "idx_bookings_reference")
  @@index([userId], map: "idx_bookings_user")
  @@index([startDate, endDate], map: "idx_bookings_dates")
  @@index([userId, startDate, endDate], map: "idx_bookings_user_dates")
  @@index([source, createdAt], map: "idx_bookings_source_created")
  @@index([accessStatus, startDate, endDate], map: "idx_bookings_access_window")
  @@map("bookings")
}

model Session {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  bookingId String    @map("booking_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([bookingId], map: "idx_sessions_booking")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@index([createdAt], map: "idx_sessions_created_at")
  @@map("sessions")
}

model Checkin {
  bookingId       String   @id @map("booking_id") @db.Uuid
  arrivalTime     String   @map("arrival_time")
  specialRequests String?  @map("special_requests")
  acceptedAt      DateTime @map("accepted_at") @db.Timestamptz(6)
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "idx_checkins_booking")
  @@index([acceptedAt], map: "idx_checkins_accepted_at")
  @@map("checkins")
}

model CheckInRequest {
  id            String               @id @db.Uuid
  bookingId     String?              @map("booking_id") @db.Uuid
  userId        String?              @map("user_id") @db.Uuid
  guestName     String?              @map("guest_name")
  guestEmail    String?              @map("guest_email")
  guestPhone    String?              @map("guest_phone")
  requestedTime String               @map("requested_time")
  message       String?
  status        CheckInRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  outboxEvents  OutboxEvent[]

  @@index([bookingId], map: "idx_check_in_requests_booking")
  @@index([userId], map: "idx_check_in_requests_user")
  @@index([status, createdAt], map: "idx_check_in_requests_status_created")
  @@map("check_in_requests")
}

model BookingClaimGrant {
  id                     String        @id @db.Uuid
  bookingId              String        @map("booking_id") @db.Uuid
  tokenDigest            String        @unique(map: "booking_claim_grants_token_digest_key") @map("token_digest") @db.Char(64)
  channel                ClaimChannel
  expiresAt              DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt              DateTime?     @map("revoked_at") @db.Timestamptz(6)
  issuedByAdminSessionId String?       @map("issued_by_admin_session_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  booking                Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  issuedByAdminSession   AdminSession? @relation(fields: [issuedByAdminSessionId], references: [id], onDelete: SetNull)

  @@index([bookingId, expiresAt], map: "idx_claim_grants_booking_expiry")
  @@index([expiresAt, consumedAt, revokedAt], map: "idx_claim_grants_cleanup")
  @@map("booking_claim_grants")
}

model StayRequest {
  id              String            @id @db.Uuid
  propertyName    String            @map("property_name")
  locale          String            @db.VarChar(8)
  startDate       DateTime          @map("start_date") @db.Date
  endDate         DateTime          @map("end_date") @db.Date
  firstName       String            @map("first_name")
  lastName        String            @map("last_name")
  email           String
  phone           String            @db.VarChar(32)
  arrivalTime     String?           @map("arrival_time")
  specialRequests String?           @map("special_requests")
  idempotencyKey  String            @unique(map: "stay_requests_idempotency_key") @map("idempotency_key")
  status          StayRequestStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  outboxEvents    OutboxEvent[]

  @@index([status, createdAt], map: "idx_stay_requests_status_created")
  @@index([email], map: "idx_stay_requests_email")
  @@map("stay_requests")
}

model OutboxEvent {
  id               String          @id @db.Uuid
  eventType        String          @map("event_type") @db.VarChar(96)
  destination      String          @db.VarChar(64)
  aggregateType    String          @map("aggregate_type") @db.VarChar(64)
  aggregateId      String          @map("aggregate_id") @db.VarChar(128)
  idempotencyKey   String          @unique(map: "outbox_events_idempotency_key") @map("idempotency_key") @db.VarChar(191)
  payload          Json
  status           OutboxStatus    @default(PENDING)
  attemptCount     Int             @default(0) @map("attempt_count")
  nextAttemptAt    DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner       String?         @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt   DateTime?       @map("lease_expires_at") @db.Timestamptz(6)
  lastError        String?         @map("last_error") @db.VarChar(2048)
  deliveredAt      DateTime?       @map("delivered_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  stayRequestId    String?         @map("stay_request_id") @db.Uuid
  stayRequest      StayRequest?    @relation(fields: [stayRequestId], references: [id], onDelete: SetNull)
  checkInRequestId String?         @map("check_in_request_id") @db.Uuid
  checkInRequest   CheckInRequest? @relation(fields: [checkInRequestId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt], map: "idx_outbox_events_delivery")
  @@index([leaseExpiresAt], map: "idx_outbox_events_lease")
  @@index([aggregateType, aggregateId], map: "idx_outbox_events_aggregate")
  @@index([checkInRequestId], map: "idx_outbox_events_check_in_request")
  @@map("outbox_events")
}

model OperationalSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("operational_settings")
}

model AdminSession {
  id                String              @id @db.Uuid
  absoluteExpiresAt DateTime            @map("absolute_expires_at") @db.Timestamptz(6)
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  claimGrants       BookingClaimGrant[]

  @@index([expiresAt], map: "idx_admin_sessions_expires")
  @@index([absoluteExpiresAt], map: "idx_admin_sessions_absolute_expires")
  @@map("admin_sessions")
}

model RefreshTokenFamily {
  id                String         @id @map("id") @db.VarChar(64)
  userId            String         @map("user_id") @db.Uuid
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revocationReason  String?        @map("revocation_reason") @db.VarChar(128)
  deviceHash        String?        @map("device_hash") @db.Char(64)
  ipHash            String?        @map("ip_hash") @db.Char(64)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens            RefreshToken[]

  @@index([userId, absoluteExpiresAt], map: "idx_refresh_families_user_expiry")
  @@index([revokedAt], map: "idx_refresh_families_revoked")
  @@map("refresh_token_families")
}

model RefreshToken {
  id            String             @id @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  tokenHash     String             @map("token_hash")
  salt          String
  familyId      String             @map("family_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(6)
  rotatedFromId String?            @map("rotated_from_id") @db.Uuid
  lastUsedAt    DateTime?          @map("last_used_at") @db.Timestamptz(6)
  deviceHint    String?            @map("device_hint")
  ipHint        String?            @map("ip_hint")
  rotatedFrom   RefreshToken?      @relation("RefreshTokenHistory", fields: [rotatedFromId], references: [id])
  rotatedTo     RefreshToken[]     @relation("RefreshTokenHistory")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  family        RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@index([revokedAt], map: "idx_refresh_tokens_revoked")
  @@index([tokenHash], map: "idx_refresh_tokens_token_hash")
  @@index([expiresAt, revokedAt], map: "idx_refresh_tokens_cleanup")
  @@index([userId, expiresAt, revokedAt], map: "idx_refresh_tokens_user_active")
  @@map("refresh_tokens")
}

model TermsAcceptance {
  id           String   @id @db.Uuid
  bookingId    String   @map("booking_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  termsVersion String   @map("terms_version") @db.VarChar(64)
  contentHash  String   @map("content_hash") @db.Char(64)
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId, termsVersion], map: "terms_acceptances_booking_user_version_key")
  @@index([acceptedAt], map: "idx_terms_acceptances_accepted_at")
  @@map("terms_acceptances")
}

model SecurityAuditEvent {
  id            String   @id @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(96)
  severity      String   @db.VarChar(16)
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipHash        String?  @map("ip_hash") @db.Char(64)
  path          String?  @db.VarChar(512)
  details       Json
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([eventType, occurredAt], map: "idx_security_events_type_time")
  @@index([severity, occurredAt], map: "idx_security_events_severity_time")
  @@map("security_audit_events")
}

model AlertRule {
  id            String   @id @db.Uuid
  name          String   @unique @db.VarChar(128)
  description   String   @db.VarChar(512)
  metricName    String   @map("metric_name") @db.VarChar(128)
  comparison    String   @db.VarChar(8)
  threshold     Float
  windowMinutes Int      @map("window_minutes")
  severity      String   @default("medium") @db.VarChar(16)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  alerts        Alert[]

  @@index([enabled], map: "idx_alert_rules_enabled")
  @@map("alert_rules")
}

model Alert {
  id                      String      @id @db.Uuid
  ruleId                  String      @map("rule_id") @db.Uuid
  status                  AlertStatus @default(OPEN)
  value                   Float
  openedAt                DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  acknowledgedAt          DateTime?   @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt              DateTime?   @map("resolved_at") @db.Timestamptz(6)
  notificationDeliveredAt DateTime?   @map("notification_delivered_at") @db.Timestamptz(6)
  notificationAttempts    Int         @default(0) @map("notification_attempts")
  notificationLastError   String?     @map("notification_last_error") @db.VarChar(1024)
  rule                    AlertRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@index([status, openedAt], map: "idx_alerts_status_opened")
  @@map("alerts")
}

model AnalyticsHit {
  id         String   @id @db.Uuid
  path       String   @db.VarChar(512)
  locale     String?  @db.VarChar(8)
  eventName  String?  @map("event_name") @db.VarChar(96)
  properties Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt], map: "idx_analytics_hits_occurred")
  @@index([path, occurredAt], map: "idx_analytics_hits_path_time")
  @@map("analytics_hits")
}

model AnalyticsVital {
  id         String   @id @db.Uuid
  name       String   @db.VarChar(16)
  value      Float
  path       String   @db.VarChar(512)
  metricId   String?  @map("metric_id") @db.VarChar(128)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt], map: "idx_analytics_vitals_occurred")
  @@index([name, occurredAt], map: "idx_analytics_vitals_name_time")
  @@map("analytics_vitals")
}

model PrivacyRequest {
  id            String               @id @db.Uuid
  userId        String?              @map("user_id") @db.Uuid
  bookingId     String?              @map("booking_id") @db.Uuid
  subjectDigest String               @map("subject_digest") @db.Char(64)
  requestType   PrivacyRequestType   @map("request_type")
  status        PrivacyRequestStatus @default(PENDING)
  requestedAt   DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz(6)
  auditNote     String?              @map("audit_note") @db.VarChar(1024)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt], map: "idx_privacy_requests_status_time")
  @@index([subjectDigest, requestedAt], map: "idx_privacy_requests_subject_time")
  @@map("privacy_requests")
}

model PrivacyHold {
  id         String    @id @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  bookingId  String?   @map("booking_id") @db.Uuid
  reason     String    @db.VarChar(512)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, releasedAt], map: "idx_privacy_holds_user")
  @@index([bookingId, releasedAt], map: "idx_privacy_holds_booking")
  @@map("privacy_holds")
}

model MfaFactor {
  id              String          @id @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  type            MfaFactorType
  secretHash      String          @map("secret_hash")
  secretSalt      String          @map("secret_salt")
  backupCodesHash String?         @map("backup_codes_hash")
  backupCodesSalt String?         @map("backup_codes_salt")
  phoneNumberEnc  String?         @map("phone_number_enc")
  emailEnc        String?         @map("email_enc")
  status          MfaFactorStatus
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt     DateTime?       @map("activated_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?       @map("last_used_at") @db.Timestamptz(6)
  challenges      MfaChallenge[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_mfa_factors_user_id")
  @@index([type], map: "idx_mfa_factors_type")
  @@index([status], map: "idx_mfa_factors_status")
  @@index([createdAt], map: "idx_mfa_factors_created_at")
  @@index([activatedAt], map: "idx_mfa_factors_activated_at")
  @@index([lastUsedAt], map: "idx_mfa_factors_last_used_at")
  @@map("mfa_factors")
}

model MfaChallenge {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  factorId          String    @map("factor_id") @db.Uuid
  challengeCodeHash String    @map("challenge_code_hash")
  challengeCodeSalt String    @map("challenge_code_salt")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  factor            MfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_mfa_challenges_user_id")
  @@index([factorId], map: "idx_mfa_challenges_factor_id")
  @@index([expiresAt], map: "idx_mfa_challenges_expires_at")
  @@index([completedAt], map: "idx_mfa_challenges_completed_at")
  @@index([createdAt], map: "idx_mfa_challenges_created_at")
  @@map("mfa_challenges")
}

model CacheEntry {
  key       String   @id
  value     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_cache_expires_at")
  @@index([key], map: "idx_cache_key")
  @@map("cache")
}

model RateLimit {
  key       String   @id
  count     Int
  resetTime DateTime @map("reset_time") @db.Timestamptz(6)

  @@index([resetTime], map: "idx_rate_limits_reset_time")
  @@index([count], map: "idx_rate_limits_count")
  @@map("rate_limits")
}

model Metric {
  id         String   @id @db.Uuid
  metricName String   @map("metric_name")
  value      Float
  tags       String
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)

  @@index([metricName], map: "idx_metrics_name")
  @@index([recordedAt], map: "idx_metrics_recorded_at")
  @@map("metrics")
}

model Log {
  id        String   @id @db.Uuid
  level     String
  message   String
  meta      String
  timestamp DateTime @map("timestamp") @db.Timestamptz(6)

  @@index([level], map: "idx_logs_level")
  @@index([timestamp], map: "idx_logs_timestamp")
  @@map("logs")
}

enum CountryOrigin {
  GR
  ABROAD
}

enum BookingSource {
  ONSITE
  EXTERNAL
}

enum AccessStatus {
  PENDING
  VERIFIED
}

enum ClaimChannel {
  REMOTE
  ONSITE
}

enum CheckInRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StayRequestStatus {
  PENDING
  DELIVERED
  DELIVERY_FAILED
  CLOSED
}

enum OutboxStatus {
  PENDING
  LEASED
  DELIVERED
  DEAD
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum PrivacyRequestType {
  EXPORT
  ERASURE
}

enum PrivacyRequestStatus {
  PENDING
  VERIFIED
  COMPLETED
  REJECTED
}

enum MfaFactorType {
  TOTP
  SMS
  EMAIL
  BACKUP_CODE
}

enum MfaFactorStatus {
  ACTIVE
  INACTIVE
  PENDING
}
